// curva PT em pu do Pmpp nominal vs temperatura
// Pmpp declarado em 25 graus
New XYCurve.MyPvsT npts=4  xarray=[0  25  75  100]  yarray=[1.2 1.0 0.8  0.6] 

// curva de eficiencia em pu vs potencia em pu
New XYCurve.MyEff npts=4  xarray=[.1  .2  .4  1.0]  yarray=[.86  .9  .93  .97]  

// curva de irradiancia em pu
New Loadshape.MyIrrad npts=24 interval=1 mult=[0 0 0 0 0 0 .1 .2 .3  .5  .8  .9  1.0  1.0  .99  .9  .7  .4  .1 0  0  0  0  0]

// curva 24h para temperatura
New Tshape.MyTemp npts=24 interval=1 temp=[25, 25, 25, 25, 25, 25, 25, 25, 35, 40, 45, 50  60 60  55 40  35  30  25 25 25 25 25 25]

// definicao dos sistemas fotovoltaicos

New PVSystem.PV_675 phases=3 bus1=675 kV=4.16  kVA=1100  irrad=.98  Pmpp=1000 temperature=25 PF=1 %cutin=0.1 %cutout=0.1  effcurve=Myeff  P-TCurve=MyPvsT Daily=MyIrrad  TDaily=MyTemp !default for inverter is unity PF
New PVSystem.PV_634 phases=3 bus1=634 kV=0.48 kVA=400  irrad=.98  Pmpp=350 temperature=25 PF=1 %cutin=0.1 %cutout=0.1  effcurve=Myeff  P-TCurve=MyPvsT Daily=MyIrrad  TDaily=MyTemp !default for inverter is unity PF



